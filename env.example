# ─────────────────────────────────────────────────────────────
# Renombra este archivo a .env  (nunca subas .env a git)
# ─────────────────────────────────────────────────────────────

# Tu llave privada de MetaMask (con 0x adelante)
PRIVATE_KEY=0xTuLlavePrivadaAqui

# RPC de la red donde está desplegado el contrato
# Ejemplos:
#   Mainnet Ethereum:  https://mainnet.infura.io/v3/TU_KEY
#   Polygon:           https://polygon-mainnet.infura.io/v3/TU_KEY
#   BNB Chain:         https://bsc-dataseed.binance.org
#   Sepolia (testnet): https://sepolia.infura.io/v3/TU_KEY
RPC_URL=https://mainnet.infura.io/v3/TU_KEY

# Dirección del contrato InvoiceSystem desplegado
CONTRACT_ADDRESS=0xDireccionDelContratoAqui
